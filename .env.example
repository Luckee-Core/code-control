# --- API proxy (Express) ---
# Next.js rewrites /api/* to this URL. Default :3010 in development.
CODE_CONTROL_API_URL=http://127.0.0.1:3010
# Optional browser-visible override (rarely needed)
# NEXT_PUBLIC_CODE_CONTROL_API_URL=http://localhost:3010

# --- Optional — GitHub org picker (Repositories tab) ---
# Should match GITHUB_ALLOWED_OWNERS on Express. See companion docs/oss-quickstart.md#connect-github
# NEXT_PUBLIC_GITHUB_ALLOWED_ORGS=your-github-org
# NEXT_PUBLIC_GITHUB_DEFAULT_ORG=your-github-org

# --- Optional — Supabase Auth scaffold (/login; app opens /projects without login) ---
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
